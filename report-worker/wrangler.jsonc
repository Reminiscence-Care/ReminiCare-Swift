{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reminicare-report-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Secrets (wrangler secret put): GITHUB_TOKEN, REPORT_REPO
  "ratelimits": [
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "2041",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // reportId → issue: stops duplicate issues on resend and authorizes audio uploads.
  "kv_namespaces": [{ "binding": "REPORT_IDS", "id": "c26627845bc942fc940b35341dc377a6" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
